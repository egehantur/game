import random
from turtledemo.sorting_animate import Block
from ursina import *
from ursina.prefabs.first_person_controller import FirstPersonController

app = Ursina()

player = FirstPersonController()
coordinate_text = Text(text='', position=(-0.8, 0.45), scale=1.5)
def update():
    px, py, pz = round(player.x, 1), round(player.y, 1), round(player.z, 1)
    coordinate_text.text = f'Position: {px}, {py}, {pz}'
Sky()

Text.default_resolution = 1080 * Text.size
ui_panel = Text(
    text='[1] Grass  [2] Stone  [3] Brick [4] Wood [5] Leaves [6] Bedrock',
    position=(0, -0.4),
    origin=(0, 0),
    scale=2,
    background=True
)

info_text = Text(
    text='Grass',
    position=(-0.1, 0.45),
    scale=2,
    color=color.white
)

selected_block = 'grass.jpg'

def add_block(position, texture):
    new_block = Button(
        parent=scene,
        model='cube',
        texture=texture,
        position=position,
        origin_y=0.5,
        color=color.white,
        highlight_color=color.white66,
    )
    return new_block

def add_tree(pos):
    x, y, z = pos
    for i in range(random.randint(2,6)):
        add_block((x, y+i, z), 'wood.png')
    for ly in range(2):
        for lx in range(-1, 2):
            for lz in range(-1, 2):
                add_block((x + lx, y + i + ly, z + lz), 'leaves.png')

for i in range(5):
    rx = random.randint(2, 17)
    rz = random.randint(2, 17)
    add_tree((rx, 1, rz))
for i in range(40):
    add_block((random.randint(0,14), 1 , random.randint(0,14)), 'grass.png')
for z in range(20):
    for x in range(20):
        add_block((x, 0, z), 'grass.png')
        add_block((x, -1, z), 'stone.png')
        add_block((x, -2, z), 'stone.png')
        add_block((x, -3, z), 'stone.png')
        add_block((x, -4, z), 'noise.png')

def input(key):
    global selected_block

    if key == '1':
        selected_block = 'grass.png'
        info_text.text = 'Grass'
    if key == '2':
        selected_block = 'stone.png'
        info_text.text = 'Stone'
    if key == '3':
        selected_block = 'brick.png'
        info_text.text = 'Brick'
    if key == '4':
        selected_block = 'wood.png'
        info_text.text = 'Wood'
    if key == '5':
        selected_block = 'leaves.png'
        info_text.text = 'Leaves'
    if key == '6':
        selected_block = 'noise.png'
        info_text.text = 'Bedrock'

    if key == 'left mouse down':
        if mouse.hovered_entity:
            add_block(mouse.hovered_entity.position + mouse.normal, selected_block)

    if key == 'right mouse down':
        if mouse.hovered_entity:
            if mouse.hovered_entity.y > -4:
                destroy(mouse.hovered_entity)

app.run()
